DATABASE_URL=file:local.db

# Set to the public HTTPS origin behind Cloudflare Tunnel in production.
# ORIGIN=https://factorio.luan.sh

# Native server management (Linux with systemd user services)
# FACMANDU_OPERATOR_USER_IDS=your-facmandu-user-id
# FACMANDU_SERVER_DIRECTORY=/var/lib/facmandu/servers
# BODY_SIZE_LIMIT=101M

# Optional durable local replica for a remote Turso database (one app process).
# FACMANDU_REPLICA_PATH=/var/lib/facmandu/replica.db
# FACMANDU_CACHE_DIR=/var/cache/facmandu

# Optional durable private conversation storage. API keys are configured per account.
# FACMANDU_AGENT_DATA=/var/lib/facmandu/agent
