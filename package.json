{
	"name": "factorio-manager",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "bun@1.4.2",
	"scripts": {
		"dev": "vite dev",
		"test": "bun test tests",
		"test:http": "bun tests/integration/http.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "if test -x node_modules/.bin/svelte-kit; then svelte-kit sync; fi",
		"check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
		"check:watch": "svelte-check --tsgo --tsconfig ./tsconfig.json --watch",
		"format": "biome format --write .",
		"lint": "biome check .",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"start": "bun ./build/index.js",
		"lint:fix": "biome check --write ."
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.14",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.48.0",
		"@sveltejs/adapter-node": "^5.5.7",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.3",
		"@typescript/native": "npm:typescript@7.0.2",
		"bits-ui": "^2.19.3",
		"clsx": "^2.1.1",
		"drizzle-kit": "^0.31.11",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"vite": "^8.3.1"
	},
	"dependencies": {
		"@earendil-works/pi-ai": "0.99.1",
		"@flue/runtime": "2.2.2",
		"@libsql/client": "^0.18.0",
		"@node-rs/argon2": "^2.2.1",
		"@oslojs/crypto": "^1.0.1",
		"@oslojs/encoding": "^1.1.0",
		"drizzle-orm": "^0.45.3",
		"fengari": "^0.1.5",
		"fflate": "^0.8.3",
		"micromark": "^4.0.3",
		"micromark-extension-gfm-table": "^2.1.2",
		"valibot": "^1.1.0",
		"zod": "^4.6.5"
	},
	"overrides": {
		"cookie": "1.1.1",
		"esbuild": "0.28.2",
		"picomatch": "4.0.7",
		"ws": "8.21.3",
		"@earendil-works/pi-ai": "0.99.1"
	}
}
